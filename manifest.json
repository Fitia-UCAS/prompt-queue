{
  "manifest_version": 3,
  "name": "PromptQueue",
  "version": "0.6.34",
  "description": "Queue prompts and attachments in ChatGPT, Gemini, and DeepSeek, then run each step after the previous reply finishes.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 PromptQueue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "resources": [
        "shared/rpc.js",
        "content/chain-runner.mjs",
        "shared/platforms.mjs",
        "shared/platforms.js",
        "content/deepseek-adapter.mjs",
        "content/gemini-upload.mjs",
        "content/site.js",
        "content/site-host.js",
        "content/site-adapters.js",
        "content/site-api.js",
        "content/site-styles.js",
        "content/composer.js",
        "content/composer-send.js",
        "content/send-lock.js",
        "content/send-queue.js",
        "content/palette.js",
        "content/prompt-editor.js",
        "content/status-panel.js"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "vendor/marked/marked.js",
        "shared/platforms.js",
        "shared/model.js",
        "content/history-reader.js",
        "content/site-messages.js",
        "content/message-reader.js",
        "content/supervisor-engine.js",
        "content/bridge.js",
        "content/native-files.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
